                  "});\r",
                  "\r",
                  "pm.test(\"Booking deve pertencer ao usuário criado\", function () {\r",
                  "    pm.expect(response.firstname).to.eql(\"Bruno\");\r",
                  "    pm.expect(response.lastname).to.eql(\"Ramos\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Valor total deve estar correto\", function () {\r",
                  "    pm.expect(response.totalprice).to.eql(450);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Datas do booking devem estar corretas\", function () {\r",
                  "    pm.expect(response.bookingdates.checkin).to.eql(\"2026-09-10\");\r",
                  "    pm.expect(response.bookingdates.checkout).to.eql(\"2026-09-15\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Necessidade adicional deve ser Breakfast\", function () {\r",
                  "    pm.expect(response.additionalneeds).to.eql(\"Breakfast\");\r",
                  "});\r",
                  "const schema = {\r",
                  "    type: \"object\",\r",
                  "    required: [\r",
                  "        \"firstname\",\r",
                  "        \"lastname\",\r",
                  "        \"totalprice\",\r",
                  "        \"depositpaid\",\r",
                  "        \"bookingdates\",\r",
                  "        \"additionalneeds\"\r",
                  "    ],\r",
                  "    properties: {\r",
                  "        firstname: {\r",
                  "            type: \"string\"\r",
                  "        },\r",
                  "        lastname: {\r",
                  "            type: \"string\"\r",
                  "        },\r",
                  "        totalprice: {\r",
                  "            type: \"number\"\r",
                  "        },\r",
