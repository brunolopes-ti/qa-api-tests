                  "            required: [\r",
                  "                \"checkin\",\r",
                  "                \"checkout\"\r",
                  "            ],\r",
                  "            properties: {\r",
                  "                checkin: {\r",
                  "                    type: \"string\"\r",
                  "                },\r",
                  "                checkout: {\r",
                  "                    type: \"string\"\r",
                  "                }\r",
                  "            }\r",
                  "        },\r",
                  "        additionalneeds: {\r",
                  "            type: \"string\"\r",
                  "        }\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "pm.test(\"Schema da resposta deve ser válido\", function () {\r",
                  "    pm.response.to.have.jsonSchema(schema);\r",
