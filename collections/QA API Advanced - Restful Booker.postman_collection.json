                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve conter bookingid\", function () {\r",
                  "    pm.expect(response).to.have.property(\"bookingid\");\r",
                  "    pm.expect(response.bookingid).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Dados do booking devem estar corretos\", function () {\r",
                  "    pm.expect(response.booking.firstname).to.eql(\"Bruno\");\r",
                  "    pm.expect(response.booking.lastname).to.eql(\"Ramos\");\r",
                  "    pm.expect(response.booking.totalprice).to.eql(450);\r",
                  "    pm.expect(response.booking.depositpaid).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "if (response.bookingid) {\r",
                  "    pm.environment.set(\"bookingId\", response.bookingid);\r",
                  "}\r",
                  "\r",
                  "pm.test(\"bookingId deve ser salvo no Environment\", function () {\r",
                  "    pm.expect(pm.environment.get(\"bookingId\")).to.eql(response.bookingid);\r",
                  "});"
