      "name": "02 - Authentication",
      "item": [
        {
          "name": "CT-02 - Gerar token de autenticação",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Status code deve ser 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta deve conter um token\", function () {\r",
                  "    pm.expect(response).to.have.property(\"token\");\r",
                  "    pm.expect(response.token).to.be.a(\"string\").and.not.empty;\r",
                  "});\r",
                  "\r",
                  "if (response.token) {\r",
                  "    pm.environment.set(\"token\", response.token);\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Token deve ser salvo no Environment\", function () {\r",
                  "    pm.expect(pm.environment.get(\"token\")).to.eql(response.token);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
